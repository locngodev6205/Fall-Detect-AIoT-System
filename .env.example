# AnNha - copy to .env. Never overwrite an existing .env or commit real credentials.
# compose.yaml runs FastAPI with PostgreSQL/Neon or SQLite; media stays local.
# compose.database.yaml runs PostgreSQL lab + Neon/Cloudinary setup tools.

# 1. Current Docker application: host ports and browser/session policy.
WEB_PORT=8188
MAIL_PORT=8125
PUBLIC_URL=http://localhost:8188
APP_ORIGINS=http://localhost:8188,http://127.0.0.1:8188,http://localhost:5188,http://127.0.0.1:5188
# Set true ONLY when the application is served through HTTPS.
COOKIE_SECURE=false

# 2. Current storage paths INSIDE the backend container; keep them on /app/data.
DATABASE_PATH=/app/data/annha.sqlite3
MEDIA_ROOT=/app/data/media
MAX_HOME_MEDIA_BYTES=536870912

# 3. Current workers and MQTT. mqtt is the service name on the Compose network.
MQTT_ENABLED=true
WORKER_ENABLED=true
MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_TOPIC_FALL_ALERT=smartfall/alerts
# Leave blank for the supplied internal broker; external brokers need auth/ACL/TLS.
MQTT_USER=
MQTT_PASSWORD=

# 4. SMTP: defaults go to LOCAL Mailpit; use a real SMTP service for real email.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=AnNha <noreply@annha.local>
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=

# 5. Telegram: optional SERVER secret. Recipient/consent settings are per home.
TELEGRAM_BOT_TOKEN=

# 6. Optional legacy ThingsBoard integration, not required for AnNha/Neon.
TB_HOST=127.0.0.1
TB_HTTP_PORT=8080
TB_USERNAME=
TB_PASSWORD=
DEVICE_ID=RASPI_ROOM_101

# 7. ACTIVE cloud-tool configuration. Generate ignored templates with:
# python3 scripts/cloud/prepare_secrets.py
# Secrets are FILES, not copied into images or printed by tools.
NEON_SERVICE_FILE=./.secrets/pg_service.conf
NEON_PGPASS_FILE=./.secrets/pgpass
CLOUDINARY_CONFIG_FILE=./.secrets/cloudinary.env

# 8. Active PostgreSQL backend. Blank URLs require DATABASE_BACKEND=sqlite.
# Neon deployment script generates 4 restricted URLs; never use the owner for runtime.
DATABASE_BACKEND=sqlite
# Root .env is already configured for Neon on this workstation.
# Neon CLI owner URLs below are used only by migration tools, never passed to backend.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
# APP/AUTH/DEVICE/WORKER: separate pooled Neon URLs, one least-privilege login each.
# MIGRATION: direct Neon URL; deployment tool only, never frontend/Pi/backend runtime.
# Format: postgresql://LOGIN:URL_ENCODED_PASSWORD@HOST/DB?sslmode=verify-full
DATABASE_URL_APP=
DATABASE_URL_AUTH=
DATABASE_URL_DEVICE=
DATABASE_URL_WORKER=
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=3
DATABASE_CONNECT_TIMEOUT_SECONDS=15
DATABASE_STATEMENT_TIMEOUT_MS=10000

# 9. RESERVED for the future Cloudinary media adapter (not wired into backend yet).
# The READY Docker checker reads CLOUDINARY_CONFIG_FILE instead of these env values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=annha_private
CLOUDINARY_DELIVERY_TYPE=authenticated
CLOUDINARY_MAX_FILE_BYTES=26214400
CLOUDINARY_WEBHOOK_URL=
# Required in PostgreSQL mode for encrypted Telegram/mail/TTS payloads.
# Generate Fernet key and SESSION_CSRF_KEY using deploy_postgres.py.
SESSION_CSRF_KEY=
DATA_ENCRYPTION_KEY_ID=primary
DATA_ENCRYPTION_KEY=

# 10. Active Neon email alert worker (per-home opt-in + verified recipient).
# Transactional verify/reset/invite mail continues independently via SMTP_* above.
EMAIL_ALERTS_ENABLED=false
# Only needed if the chosen email provider supplies signed delivery webhooks.
EMAIL_PROVIDER_WEBHOOK_SECRET=
# Cloudinary is deferred; leave its credentials blank during the Neon integration phase.
