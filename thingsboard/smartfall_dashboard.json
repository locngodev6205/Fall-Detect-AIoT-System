          "settings": {
            "cardHtml": "<div class=\"gate-status-card\">\n  <div class=\"header-row\">\n    <div class=\"device-info\">\n      <span class=\"device-name\">RASPI_ROOM_101</span>\n      <span class=\"device-model\">SmartFall Edge AIoT (MediaPipe + Transformer)</span>\n    </div>\n    <div class=\"badge status-badge\">● ${status:ONLINE}</div>\n  </div>\n  \n  <div class=\"telemetry-body\">\n    <div class=\"mode-container\">\n      <div class=\"mode-label\">TRẠNG THÁI AI HIỆN TẠI</div>\n      <div class=\"mode-value\">${ai_state:NO_PERSON}</div>\n    </div>\n    \n    <div class=\"telemetry-badges\">\n      <div class=\"badge-item\">\n        <span class=\"badge-label\">Trong hình:</span>\n        <span class=\"badge-val badge-AWAKE\">${person_status:KHÔNG CÓ NGƯỜI}</span>\n      </div>\n      <div class=\"badge-item\">\n        <span class=\"badge-label\">Đối tượng:</span>\n        <span class=\"badge-val badge-AWAKE\">${target_audience:elderly}</span>\n      </div>\n      <div class=\"badge-item\">\n        <span class=\"badge-label\">P(Fall):</span>\n        <span class=\"badge-val latch-READY\">${fall_prob:0.00}</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"section-divider\"></div>\n\n  <div class=\"hw-section\">\n    <div class=\"section-title\">🚨 CHỈ SỐ AN TOÀN & CẢNH BÁO GẦN NHẤT</div>\n    <div class=\"hw-grid\">\n      <div class=\"hw-box\">\n        <span class=\"hw-name\">TG Bất Động</span>\n        <span class=\"hw-val\">${immobile_seconds:0}s</span>\n      </div>\n      <div class=\"hw-box\">\n        <span class=\"hw-name\">Sự Kiện Gần Nhất</span>\n        <span class=\"hw-val\">${last_alert_event:NONE}</span>\n      </div>\n      <div class=\"hw-box\">\n        <span class=\"hw-name\">Thời Điểm Báo</span>\n        <span class=\"hw-val\">${last_alert_time:--:--}</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"footer-row\">\n    <div class=\"info-item\">Chuỗi: <span>30 frames (17 khớp)</span></div>\n    <div class=\"info-item\">Tốc độ: <span>${fps:0} FPS</span></div>\n    <div class=\"info-item\">Model: <span>Transformer TFLite</span></div>\n  </div>\n</div>",
            "cardCss": ".gate-status-card {\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);\n  border: 1px solid #334155;\n  border-radius: 12px;\n  padding: 14px 18px;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  box-sizing: border-box;\n  font-family: \"Inter\", -apple-system, sans-serif;\n  color: #e2e8f0;\n}\n.header-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.device-info {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n.device-name {\n  color: #f8fafc;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n.device-model {\n  color: #64748b;\n  font-size: 10px;\n  font-weight: 500;\n}\n.status-badge {\n  background: rgba(16, 185, 129, 0.15);\n  color: #10b981;\n  border: 1px solid rgba(16, 185, 129, 0.4);\n  padding: 3px 10px;\n  border-radius: 20px;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n}\n.telemetry-body {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin: 4px 0;\n}\n.mode-label {\n  color: #64748b;\n  font-size: 10px;\n  font-weight: 600;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n.mode-value {\n  color: #38bdf8;\n  font-size: 24px;\n  font-weight: 800;\n  letter-spacing: -0.02em;\n  text-shadow: 0 0 16px rgba(56, 189, 248, 0.3);\n}\n.telemetry-badges {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  align-items: flex-end;\n}\n.badge-item {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 11px;\n}\n.badge-label {\n  color: #94a3b8;\n  font-weight: 600;\n}\n.badge-val {\n  padding: 2px 7px;\n  border-radius: 6px;\n  font-weight: 700;\n  font-size: 10px;\n}\n.badge-AWAKE {\n  background: rgba(16, 185, 129, 0.2);\n  color: #10b981;\n  border: 1px solid rgba(16, 185, 129, 0.4);\n}\n.badge-SLEEP {\n  background: rgba(100, 116, 139, 0.2);\n  color: #94a3b8;\n  border: 1px solid rgba(100, 116, 139, 0.3);\n}\n.latch-READY {\n  background: rgba(56, 189, 248, 0.2);\n  color: #38bdf8;\n  border: 1px solid rgba(56, 189, 248, 0.4);\n}\n.latch-LOCKED {\n  background: rgba(245, 158, 11, 0.2);\n  color: #f59e0b;\n  border: 1px solid rgba(245, 158, 11, 0.4);\n}\n.section-divider {\n  height: 1px;\n  background: #334155;\n  margin: 4px 0;\n}\n.section-title {\n  color: #94a3b8;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n  margin-bottom: 4px;\n  text-transform: uppercase;\n}\n.hw-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 8px;\n}\n.hw-box {\n  background: rgba(15, 23, 42, 0.6);\n  border: 1px solid rgba(51, 65, 85, 0.8);\n  border-radius: 8px;\n  padding: 6px 8px;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n.hw-name {\n  color: #64748b;\n  font-size: 9px;\n  font-weight: 600;\n  text-transform: uppercase;\n}\n.hw-val {\n  color: #f1f5f9;\n  font-size: 13px;\n  font-weight: 700;\n}\n.val-temp {\n  color: #10b981;\n}\n.periph-grid {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n.periph-box {\n  background: rgba(15, 23, 42, 0.5);\n  border: 1px solid rgba(51, 65, 85, 0.6);\n  border-radius: 6px;\n  padding: 3px 8px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 10px;\n}\n.periph-name {\n  color: #94a3b8;\n  font-weight: 600;\n}\n.periph-val {\n  color: #38bdf8;\n  font-weight: 700;\n}\n.badge-toggle {\n  color: #a7f3d0;\n}\n.footer-row {\n  display: flex;\n  justify-content: space-between;\n  border-top: 1px solid #334155;\n  padding-top: 6px;\n  margin-top: 2px;\n}\n.info-item {\n  color: #64748b;\n  font-size: 10px;\n}\n.info-item span {\n  color: #cbd5e1;\n  font-weight: 600;\n}"
          },
