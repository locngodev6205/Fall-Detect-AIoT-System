# Device & Target Audience
DEVICE_ID=RASPI_ROOM_101
TARGET_AUDIENCE=elderly       # "elderly" (người già) hoặc "child" (trẻ nhỏ)

# AI & Immobility Thresholds
FALL_CONFIDENCE_THRESHOLD=0.85
FALL_EVENT_COOLDOWN=10
ENABLE_IMMOBILITY_DETECTION=true
IMMOBILITY_TIMEOUT_SECONDS=120 # 30s cho trẻ em, 120s cho người già

# MQTT Broker (Backend Server IP)
ENABLE_MQTT=true
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC_FALL_ALERT=smartfall/alerts
MQTT_TOPIC_STATUS=smartfall/status

# Telegram Alerts (Optional)
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
