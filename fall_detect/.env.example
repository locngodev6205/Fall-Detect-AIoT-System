# Device & Target Audience
DEVICE_ID=RASPI_ROOM_101
# Device credential from backend provisioning; required by the authenticated gateway.
DEVICE_TOKEN=
TARGET_AUDIENCE=elderly       # "elderly" (người già) hoặc "child" (trẻ nhỏ)

# AI & Immobility Thresholds
FALL_CONFIDENCE_THRESHOLD=0.85
FALL_EVENT_COOLDOWN=10
ENABLE_IMMOBILITY_DETECTION=true
IMMOBILITY_TIMEOUT_SECONDS=120 # 30s cho trẻ em, 120s cho người già

# ThingsBoard IoT Platform (MQTT port 1883, xác thực bằng Access Token)
ENABLE_MQTT=true
TB_HOST=192.168.1.14
TB_PORT=1883
TB_TOKEN=smartfall_pi4_token_101
TELEMETRY_INTERVAL=2.0

# Telegram Alerts (Optional)
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
