# ==============================================================================
# CẤU HÌNH THIẾT BỊ BIÊN RASPBERRY PI 4 - ANNHÀ AIoT EDGE NODE
# Sao chép thành `.env.edge`, đặt URL backend rồi chạy `bash run_edge.sh --pair`.
# ==============================================================================

# 1. Kết nối Backend AnNhà (Thay IP LAN máy chủ khi chạy trên Raspberry Pi 4)
ANNHA_BASE_URL=http://localhost:8188
# Để trống khi dùng --pair. Chỉ điền token nếu đăng ký qua CLI quản trị.
DEVICE_TOKEN=

# 2. Kết nối Arduino Uno / Nano qua cổng USB Serial (Cảm biến DHT11, MQ-2 & 2 Servo Pan-Tilt)
# Đặt `auto` để tự động quét `/dev/ttyUSB0`, `/dev/ttyACM0`; tự chuyển sang Mock nếu chưa cắm cáp
ARDUINO_SERIAL_PORT=auto
ARDUINO_BAUDRATE=115200
PAN_DIRECTION=-1
TILT_DIRECTION=1
GAS_UNIT=ADC

# 3. Kết nối Loa Bluetooth chuyên dụng (BẮT BUỘC dùng Loa Bluetooth trên phần cứng thực)
# Điền địa chỉ MAC loa (ví dụ AA:BB:CC:11:22:33) để Pi tự động pair/trust/connect lại
BT_SPEAKER_MAC=
BT_SPEAKER_NAME=

# 4. Camera & AI Nhận diện Té ngã
CAMERA_ID=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
LIVE_STREAM_FPS=5.0

# 5. Chu kỳ đồng bộ thiết bị (giây)
HEARTBEAT_INTERVAL_S=10.0
TELEMETRY_INTERVAL_S=10.0
COMMAND_POLL_INTERVAL_S=2.0
SNAPSHOT_INTERVAL_S=30.0

# 6. Tùy chọn gửi song song Telemetry lên ThingsBoard Cloud / Local qua MQTT
THINGSBOARD_ENABLED=false
TB_HOST=127.0.0.1
TB_PORT=1883
TB_TOKEN=
