# Stage 1: Build the React frontend
FROM node:22-alpine AS frontend-build

WORKDIR /build

COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build


# Stage 2: Build the application runtime
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATABASE_BACKEND=postgres \
    MEDIA_ROOT=/tmp/annha-media \
    DEVICE_RELEASE_CACHE_DIR=/tmp/annha-releases

RUN apt-get update \
    && apt-get install -y --no-install-recommends espeak-ng \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/src ./src

COPY --from=frontend-build /build/dist/client ./static

RUN useradd --create-home app

USER app

CMD ["sh", "-c", "mkdir -p \"$MEDIA_ROOT\" \"$DEVICE_RELEASE_CACHE_DIR\" && exec uvicorn src.heroku_entrypoint:app --host 0.0.0.0 --port ${PORT:-8000} --no-access-log --ws-max-size 1048576 --ws-max-queue 4"]