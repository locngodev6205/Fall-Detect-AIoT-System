# Copy to .secrets/cloudinary.env. Values are plain KEY=value, no shell expansion.
CLOUDINARY_CLOUD_NAME=REPLACE_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_API_KEY
CLOUDINARY_API_SECRET=REPLACE_API_SECRET
# The backend performs signed uploads; no unsigned/public upload preset is used.
CLOUDINARY_ASSET_FOLDER=Fall Detection
CLOUDINARY_ENVIRONMENT=development
CLOUDINARY_DELIVERY_TYPE=authenticated
CLOUDINARY_MAX_FILE_BYTES=26214400
