# Standalone backend example, started FROM REPOSITORY ROOT.
# Pass this file through your process manager / uvicorn --env-file explicitly.
# This file is not loaded automatically by backend/src/db.py.
PUBLIC_URL=http://localhost:5188
APP_ORIGINS=http://localhost:5188,http://127.0.0.1:5188
COOKIE_SECURE=false
DATABASE_PATH=backend/data/annha.sqlite3
MEDIA_ROOT=backend/data/media
MAX_HOME_MEDIA_BYTES=536870912
MQTT_ENABLED=false
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC_FALL_ALERT=smartfall/alerts
MQTT_USER=
MQTT_PASSWORD=
WORKER_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=AnNha <noreply@annha.local>
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TB_HOST=127.0.0.1
TB_HTTP_PORT=8080
TB_USERNAME=
TB_PASSWORD=
DEVICE_ID=RASPI_ROOM_101
# Neon runtime uses DATABASE_BACKEND=postgres and the 4 restricted URLs below.
# Cloudinary remains deferred; see root .env.example.

# PostgreSQL: copy role URLs and keys from root .env when running uvicorn locally.
DATABASE_BACKEND=sqlite
DATABASE_URL_APP=
DATABASE_URL_AUTH=
DATABASE_URL_DEVICE=
DATABASE_URL_WORKER=
SESSION_CSRF_KEY=
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=primary
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=3
DATABASE_CONNECT_TIMEOUT_SECONDS=15
DATABASE_STATEMENT_TIMEOUT_MS=10000
EMAIL_ALERTS_ENABLED=false
